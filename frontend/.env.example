# Browser path for the API, including /api/v1.
# In development Vite proxies /api to http://127.0.0.1:8000, so the page and the
# refresh cookie share http://localhost:5173. Do not point this at 127.0.0.1
# while the app is opened on localhost: the refresh cookie is SameSite=Strict.
VITE_API_BASE_URL=/api/v1
