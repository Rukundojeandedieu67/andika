# ANDIKA backend environment.
# Copy this file to .env and replace the placeholder values.
# Never commit .env or put production secrets in source control.

# development, test, or production
ENVIRONMENT=development

# Set to true only on a local machine when SQL statement logging is needed.
DEBUG=false

APP_NAME=ANDIKA
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# PostgreSQL URL. postgresql:// and postgres:// are accepted and normalized
# to the psycopg driver. Use a strong password outside local development.
DATABASE_URL=postgresql+psycopg://andika:andika@127.0.0.1:5432/andika

# Replace this before any shared or production deployment.
# Production rejects placeholders and values shorter than 32 characters.
JWT_SECRET_KEY=change-me-in-development-only-not-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
AUTH_RATE_LIMIT_ENABLED=true

# Public origin used in email links. Tokens are placed in the URL fragment.
PUBLIC_APP_URL=http://localhost:5173

# Leave SMTP blank in development. The API will not claim that mail was sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Comma-separated absolute origins, or a JSON list. No wildcards in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# local or s3. Local development does not need the S3 values below.
STORAGE_PROVIDER=local
MEDIA_STORAGE_DIR=
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_WEBP_QUALITY=82
MEDIA_DELIVERY=private
MEDIA_SIGNED_URL_SECONDS=3600

# Used only when STORAGE_PROVIDER=s3. Leave these empty for local storage.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Comment length and per-account hourly limits. Rate limits follow AUTH_RATE_LIMIT_ENABLED.
COMMENT_MAX_LENGTH=2000
COMMENT_RATE_LIMIT_PER_HOUR=30
REPORT_RATE_LIMIT_PER_HOUR=10

# Publication invitations. Rate limits follow AUTH_RATE_LIMIT_ENABLED.
INVITATION_EXPIRE_HOURS=72
INVITATION_RATE_LIMIT_PER_HOUR=20
INVITATION_ACCEPT_RATE_LIMIT_PER_HOUR=10

# Article view deduplication and suggestion autocomplete. The suggestion limit follows AUTH_RATE_LIMIT_ENABLED.
VIEW_DEDUP_HOURS=6
SUGGESTION_RATE_LIMIT_PER_HOUR=60

# Notification email worker. The API records jobs; the worker sends them.
NOTIFICATION_WORKER_POLL_SECONDS=5
NOTIFICATION_WORKER_BATCH_SIZE=20
NOTIFICATION_EMAIL_MAX_ATTEMPTS=5
NOTIFICATION_RATE_LIMIT_PER_HOUR=60
